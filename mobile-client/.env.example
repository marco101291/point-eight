# Copy to .env. Only needed when the default (http://localhost:8080) doesn't reach java-system
# from wherever this app is actually running:
#   - iOS simulator / web: localhost works, leave unset.
#   - Android emulator: the emulator's own loopback is 10.0.2.2, not localhost.
#   - a physical device: use the dev machine's LAN IP (e.g. http://192.168.1.20:8080).
EXPO_PUBLIC_API_URL=http://localhost:8080
