# Copiar a .env antes de levantar el compose.

# --- Postgres: El Sistema (Java) ---
SYSTEM_DB_NAME=pointeight_system
SYSTEM_DB_USER=pointeight
SYSTEM_DB_PASSWORD=pointeight
SYSTEM_DB_PORT=5433

# --- Postgres: El Motor (Python) ---
ENGINE_DB_NAME=pointeight_engine
ENGINE_DB_USER=pointeight
ENGINE_DB_PASSWORD=pointeight
ENGINE_DB_PORT=5435

# --- RabbitMQ ---
RABBITMQ_USER=pointeight
RABBITMQ_PASSWORD=pointeight
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# --- Puertos de los servicios ---
JAVA_SYSTEM_PORT=8080
PYTHON_ENGINE_PORT=8000
ADMIN_PANEL_PORT=3001
